<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Malaya - Contact Us</title>

    <!-- Connect external CSS -->
    <link rel="stylesheet" href="contactstyle.css">
</head>

<body>

    <!-- =================================
         HEADER
    ================================== -->

    <header class="site-header">

        <!-- Announcement Bar -->
        <div class="announcement-bar">
            <p>
                <strong>FREE SHIPPING</strong>
                for every ₱1,000 purchase!
            </p>
        </div>

        <!-- Navigation Bar -->
        <div class="navbar">

            <!-- Logo -->
            <a href="#" class="logo">MALAYA</a>

            <!-- Desktop Navigation -->
            <nav class="nav-menu">
                <a href="file:///C:/Users/Administrator/Desktop/MMS%20171%20TEXT/Mid%20Fidelity%20Wireframe/sample1.html#">HOME</a>
                <a href="file:///C:/Users/Administrator/Desktop/MMS%20171%20TEXT/Mid%20Fidelity%20Wireframe/shop.html">SHOP</a>
                <a href="#">ABOUT</a>
                <a href="file:///C:/Users/Administrator/Desktop/MMS%20171%20TEXT/Mid%20Fidelity%20Wireframe/contactus.html#" class="active">CONTACT</a>
            </nav>

            <!-- Right-side Icons -->
            <div class="nav-icons">

                <a href="#" aria-label="Search">
                    SEARCH
                </a>

                <a href="#" aria-label="Account">
                    ACCOUNT
                </a>

                <a href="#" aria-label="Shopping cart">
                    CART
                </a>

            </div>

            <!-- Mobile Navigation -->
            <details class="mobile-menu">

                <summary>MENU ☰</summary>

                <nav>
                    <a href="#">HOME</a>
                    <a href="#">SHOP</a>
                    <a href="#">ABOUT</a>
                    <a href="#">CONTACT</a>
                </nav>

            </details>

        </div>

    </header>


    <!-- =================================
         CONTACT SECTION
    ================================== -->

    <main>

        <section class="contact-section">

            <!-- Contact Heading -->
            <div class="contact-heading">

                <h1>CONTACT US</h1>

                <p>
                    Malaya fully operates as an online shop,
                    and currently does not have a physical store.
                </p>

                <p>
                    If you have any questions and/or proposals,
                    kindly send us a message below.
                </p>

                <p>
                    We'd love to hear from you!
                </p>

                <br>

                <p>
                    Please expect us to get back to you
                    within 1-2 business days.
                </p>

                <p>
                    Thank you very much!
                </p>

            </div>


            <!-- Contact Form -->
            <form class="contact-form">

                <!-- Name -->
                <div class="form-group">

                    <label for="contact-name">Name</label>

                    <input
                        type="text"
                        id="contact-name"
                        name="name"
                        required
                    >

                </div>


                <!-- Email Address -->
                <div class="form-group">

                    <label for="contact-email">Email Address</label>

                    <input
                        type="email"
                        id="contact-email"
                        name="email"
                        required
                    >

                </div>


                <!-- Subject -->
                <div class="form-group">

                    <label for="contact-subject">Subject</label>

                    <input
                        type="text"
                        id="contact-subject"
                        name="subject"
                        required
                    >

                </div>


                <!-- Message -->
                <div class="form-group">

                    <label for="contact-message">Message</label>

                    <textarea
                        id="contact-message"
                        name="message"
                        rows="5"
                        required
                    ></textarea>

                </div>


                <!-- Submit Button -->
                <button type="submit" class="submit-button">
                    Send A Message
                </button>

            </form>


            <!-- Alternative Contact Information -->
            <div class="alternative-contact">

                <p>
                    For immediate concerns, you may also call us at
                    <a href="#">(+63) 917 654 3210.</a>
                </p>

            </div>

        </section>

    </main>


    <!-- =================================
         NEWSLETTER SECTION
    ================================== -->

    <section class="newsletter-section">

        <!-- Newsletter Text -->
        <div class="newsletter-text">

            <h3>JOIN OUR NEWSLETTER</h3>

            <p>
                Be the FIRST to receive the latest news,
                exclusive deals and discounts!
            </p>

        </div>


        <!-- Newsletter Form -->
        <form class="newsletter-form">

            <div class="newsletter-input-group">

                <input
                    type="email"
                    placeholder="Email address"
                    aria-label="Email address"
                >

                <button type="submit">
                    SUBSCRIBE
                </button>

            </div>

            <p class="newsletter-note">
                No spam, we hate it as much as you do.
            </p>

        </form>

    </section>


    <!-- =================================
         FOOTER
    ================================== -->

    <footer class="footer">

        <!-- Social Media -->
        <div class="footer-social">

            <h3>FOLLOW US ON</h3>

            <div class="social-links">

                <a href="#" aria-label="Facebook">F</a>

                <a href="#" aria-label="Instagram">IG</a>

                <a href="#" aria-label="YouTube">YT</a>

            </div>

        </div>


        <!-- Footer Navigation -->
        <div class="footer-links">

            <!-- About Links -->
            <div class="footer-column">

                <h3>ABOUT</h3>

                <a href="#">About Us</a>
                <a href="#">Return & Exchange</a>
                <a href="#">Shipping Policy</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>

            </div>

        </div>


        <!-- Copyright -->
        <div class="copyright">

            <p>© 2026 Malaya by the Byte of 87.</p>

        </div>

    </footer>



===CSS===


</body>
</html>
