
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Malaya - Shop</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="shopstyle.css">
</head>

<body>

    <!-- =================================
         HEADER
    ================================== -->

    <header class="site-header">

        <!-- Announcement Bar -->
        <div class="announcement-bar">
            <p><strong>FREE SHIPPING</strong> for every ₱1,000 purchase!</p>
        </div>

        <!-- Navigation -->
        <div class="navbar">

            <a href="#" class="logo">MALAYA</a>

            <!-- Desktop Navigation -->
            <nav class="nav-menu">
                <a href="file:///C:/Users/Administrator/Desktop/MMS%20171%20TEXT/Mid%20Fidelity%20Wireframe/sample1.html">HOME</a>
                <a href="file:///C:/Users/Administrator/Desktop/MMS%20171%20TEXT/Mid%20Fidelity%20Wireframe/shop.html" class="active">SHOP</a>
                <a href="#">ABOUT</a>
                <a href="file:///C:/Users/Administrator/Desktop/MMS%20171%20TEXT/Mid%20Fidelity%20Wireframe/contactus.html#">CONTACT</a>
            </nav>

            <!-- Right Navigation Icons -->
            <div class="nav-icons">
                <a href="#" aria-label="Search">SEARCH</a>
                <a href="#" aria-label="Account">ACCOUNT</a>
                <a href="#" aria-label="Cart">CART</a>
            </div>

            <!-- Mobile Navigation -->
            <details class="mobile-menu">
                <summary>MENU ☰</summary>

                <nav>
                    <a href="#">HOME</a>
                    <a href="#">SHOP</a>
                    <a href="#">ABOUT</a>
                    <a href="#">CONTACT</a>
                </nav>
            </details>

        </div>

    </header>


    <!-- =================================
         SHOP HERO BANNER
    ================================== -->

    <section class="shop-hero">

        <!-- Banner Placeholder -->
        <div class="hero-image-placeholder">

            <div class="hero-content">

                <h1>SHOP NOW</h1>

                <a href="#" class="size-chart-button">
                    View Size Chart
                </a>

            </div>

        </div>

        <!-- Banner Slider Indicators -->
        <div class="slider-dots">
            <span class="dot active"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
        </div>

    </section>


    <!-- =================================
         CATEGORY AND FILTER BAR
    ================================== -->

    <section class="shop-controls">

        <!-- Category Navigation -->
        <div class="category-navigation">

            <h2>ALL ITEMS (3)</h2>

            <nav class="category-links">
                <a href="#">CATEGORY</a>
                <a href="#">CATEGORY</a>
                <a href="#">CATEGORY</a>
            </nav>

        </div>


        <!-- Sort Dropdown -->
        <div class="sort-container">

            <label for="sort-products">SORT BY</label>

            <select id="sort-products" name="sort-products">
                <option value="featured">Featured</option>
                <option value="newest">New Arrivals</option>
                <option value="bestseller">Best Seller</option>
                <option value="low-high">Price, Low to High</option>
                <option value="high-low">Price, High to Low</option>
            </select>

        </div>

    </section>


    <!-- =================================
         PRODUCT LISTING
    ================================== -->

    <main class="shop-products">

        <div class="product-container">

            <!-- PRODUCT 1 -->
            <article class="product-card">

                <a href="#" class="product-image-link">
                    <div class="product-image-placeholder"></div>
                </a>

                <div class="product-details">

                    <p class="product-color">○</p>

                    <p class="product-category">
                        Unisex, XS - 3XL
                    </p>

                    <h3>
                        <a href="#">Product Name One</a>
                    </h3>

                    <p class="product-price">₱ 499.00</p>

                    <div class="product-info">
                        <span>★ 4.8 (155)</span>
                        <span>In-stock</span>
                    </div>

                </div>

            </article>


            <!-- PRODUCT 2 -->
            <article class="product-card">

                <a href="#" class="product-image-link">
                    <div class="product-image-placeholder"></div>
                </a>

                <div class="product-details">

                    <p class="product-color">●</p>

                    <p class="product-category">
                        Unisex, XS - 3XL
                    </p>

                    <h3>
                        <a href="#">Product Name Two</a>
                    </h3>

                    <p class="product-price">₱ 499.00</p>

                    <div class="product-info">
                        <span>★ 5.0 (206)</span>
                        <span>In-stock</span>
                    </div>

                </div>

            </article>


            <!-- PRODUCT 3 -->
            <article class="product-card">

                <a href="#" class="product-image-link">
                    <div class="product-image-placeholder"></div>
                </a>

                <div class="product-details">

                    <p class="product-color">●</p>

                    <p class="product-category">
                        Unisex, XS - 3XL
                    </p>

                    <h3>
                        <a href="#">Product Name Three</a>
                    </h3>

                    <p class="product-price">₱ 499.00</p>

                    <div class="product-info">
                        <span>★ 4.9 (182)</span>
                        <span>In-stock</span>
                    </div>

                </div>

            </article>

        </div>

    </main>


    <!-- =================================
         NEWSLETTER
    ================================== -->

    <section class="newsletter-section">

        <div class="newsletter-text">
            <h3>JOIN OUR NEWSLETTER</h3>

            <p>
                Be the FIRST to receive the latest news,
                exclusive deals and discounts!
            </p>
        </div>

        <form class="newsletter-form">

            <div class="newsletter-input-group">

                <input
                    type="email"
                    placeholder="Email address"
                    aria-label="Email address"
                >

                <button type="submit">SUBSCRIBE</button>

            </div>

            <p class="newsletter-note">
                No spam, we hate it as much as you do.
            </p>

        </form>

    </section>


    <!-- =================================
         FOOTER
    ================================== -->

    <footer class="footer">

        <!-- Social Media -->
        <div class="footer-social">

            <h3>FOLLOW US ON</h3>

            <div class="social-links">
                <a href="#" aria-label="Facebook">F</a>
                <a href="#" aria-label="Instagram">IG</a>
                <a href="#" aria-label="YouTube">YT</a>
            </div>

        </div>


        <!-- Footer Links -->
        <div class="footer-links">

            <div class="footer-column">

                <h3>ABOUT</h3>

                <a href="#">About Us</a>
                <a href="#">Return & Exchange</a>
                <a href="#">Shipping Policy</a>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms of Service</a>

            </div>


            <div class="footer-column">

                <h3>HELP</h3>

                <a href="#">Contact Us</a>
                <a href="#">FAQs</a>
                <a href="#">Track Order</a>

            </div>

        </div>


        <!-- Copyright -->
        <div class="copyright">
            <p>© 2026 Malaya by the Byte of 87.</p>
        </div>

    </footer>

</body>
</html>


